#!/bin/sh
# Bloquea el push directo a main (DEC-01): main solo recibe cambios por PR desde dev.
# Se activa una vez por clon: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: push directo a main bloqueado (DEC-01). Abre un PR desde dev." >&2
    exit 1
  fi
done
exit 0
